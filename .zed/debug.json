// see: https://zed.dev/docs/debugger
[
  {
    "label": "CMake: Build and Debug",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/build/sanskrit-breakdown",
    "cwd": "$ZED_WORKTREE_ROOT",
    "build": {
      "command": "cmake",
      "args": [
        "--build",
        "$ZED_WORKTREE_ROOT/build",
      ],
      "cwd": "$ZED_WORKTREE_ROOT"
    }
  }
]
